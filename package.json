{
  "name": "pi-coder",
  "version": "0.4.2",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "description": "Interactive code diff editor for Pi with comments, AI-assisted review handoff, configured pull-request integration, and local or remote diff support.",
  "author": "Leonardo Pereira",
  "license": "MIT",
  "files": [
    "src/diff.ts",
    "src/git.ts",
    "src/git-change-status.ts",
    "src/git-filter-policy.ts",
    "src/index.ts",
    "src/locale-files.ts",
    "src/pi-render.ts",
    "src/path-policy.ts",
    "src/prompt.ts",
    "src/provider-settings.ts",
    "src/pr-handoff.ts",
    "src/pr-summary.ts",
    "src/remote.ts",
    "src/review-grammar.ts",
    "src/review-order.ts",
    "src/review-receipts.ts",
    "src/review-replies.ts",
    "src/review-session.ts",
    "src/review-submit.ts",
    "src/sanitize.ts",
    "src/search.ts",
    "src/seed-comments.ts",
    "src/shortcuts.ts",
    "src/state.ts",
    "src/syntax-highlight.ts",
    "src/theme-highlight.ts",
    "src/types.ts",
    "src/ui",
    "src/adapters",
    "src/workbench",
    "docs",
    "scripts",
    "tsconfig.workbench.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "diff-review",
    "code-diff",
    "code-review",
    "diff-editor",
    "annotation",
    "pull-request",
    "remote-diff",
    "ai-review",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark": "vitest bench --run",
    "workbench:bench": "vitest bench --run src/benchmark/workbench.bench.ts",
    "workbench:build": "node scripts/build-workbench.mjs",
    "workbench:start": "node scripts/start-workbench.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.78.0",
    "@earendil-works/pi-tui": "0.78.0",
    "@pierre/diffs": "1.2.7",
    "@types/node": "24.12.4",
    "shiki": "3.23.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.78.0"
  },
  "devDependencies": {
    "vitest": "3.2.6"
  }
}
