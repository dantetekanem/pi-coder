{
  "name": "pi-coder",
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "description": "Interactive diff review, diff stories, and code workbench for Pi, any agent harness, or a plain terminal, with annotations, pull-request reviews, and agent handoffs.",
  "author": "Leonardo Pereira <contato@leonardopereira.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantetekanem/pi-coder.git"
  },
  "homepage": "https://github.com/dantetekanem/pi-coder#readme",
  "bugs": {
    "url": "https://github.com/dantetekanem/pi-coder/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pi-coder": "./bin/pi-coder.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin",
    "src/cli",
    "src/host",
    "src/pi",
    "src/engine.ts",
    "src/tool-definitions.ts",
    "src/conversation.ts",
    "src/diff.ts",
    "src/git.ts",
    "src/git-change-status.ts",
    "src/git-filter-policy.ts",
    "src/index.ts",
    "src/locale-files.ts",
    "src/pi-render.ts",
    "src/path-policy.ts",
    "src/prompt.ts",
    "src/provider-settings.ts",
    "src/provider-rest-pages.ts",
    "src/pr-handoff.ts",
    "src/pr-summary.ts",
    "src/preferences.ts",
    "src/remote.ts",
    "src/review-grammar.ts",
    "src/review-agent.ts",
    "src/diff-story",
    "prompts",
    "skills/diff-story",
    "skills/pi-coder",
    "src/review-order.ts",
    "src/review-receipts.ts",
    "src/review-replies.ts",
    "src/review-threads.ts",
    "src/review-session.ts",
    "src/review-session-persistence.ts",
    "src/review-composition.ts",
    "src/review-submit.ts",
    "src/review-submission-journal.ts",
    "src/review-submission-reconcile.ts",
    "src/review-submission-consumption.ts",
    "src/sanitize.ts",
    "src/search.ts",
    "src/seed-comments.ts",
    "src/source-links.ts",
    "src/shortcuts.ts",
    "src/state.ts",
    "src/syntax-highlight.ts",
    "src/theme-highlight.ts",
    "src/types.ts",
    "src/ui",
    "src/adapters",
    "src/workbench",
    "docs/*.md",
    "scripts/build-workbench.mjs",
    "scripts/build-workbench.d.mts",
    "scripts/start-workbench.mjs",
    "tsconfig.workbench.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "diff-review",
    "code-diff",
    "code-review",
    "diff-editor",
    "annotation",
    "pull-request",
    "remote-diff",
    "ai-review",
    "terminal",
    "cli",
    "mcp",
    "agent",
    "claude-code",
    "codex"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": ["./skills/diff-story"],
    "image": "https://raw.githubusercontent.com/dantetekanem/pi-coder/main/docs/assets/code.gif"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "benchmark": "vitest bench --run",
    "workbench:bench": "vitest bench --run src/benchmark/workbench.bench.ts",
    "workbench:build": "node scripts/build-workbench.mjs",
    "workbench:start": "node scripts/start-workbench.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": ">=0.79.10 <2",
    "@pierre/diffs": "1.2.7",
    "highlight.js": "11.12.0",
    "jiti": "2.7.0",
    "shiki": "4.6.0",
    "typebox": "^1.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.79.10",
    "@earendil-works/pi-coding-agent": ">=0.79.10"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.79.10",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
